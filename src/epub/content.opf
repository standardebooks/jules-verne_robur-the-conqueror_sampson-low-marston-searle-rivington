		<dc:title id="title">Robur the Conqueror</dc:title>
		<meta property="file-as" refines="#title">Robur the Conqueror</meta>
		<meta property="dcterms:alternative" refines="#title">The Clipper of the Clouds</meta>
		<dc:subject id="subject-1">Science fiction</dc:subject>
		<meta property="authority" refines="#subject-1">LCSH</meta>
